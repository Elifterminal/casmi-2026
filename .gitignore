# re-downloading that notebook's output; not ours to redistribute.
local-assets/
# Local validation run artifacts: regenerated parquet, 4.2 GB.
fork-w088/localrun/
fork-w088/localrun_50.log
# Work lists for the ICEBERG runs (9.4 MB). Derived from the competition training set, so they stay
# out of a public repo for the same reason work/data/ does; regenerable from e65/e49 + the splits.
exports/*.json
