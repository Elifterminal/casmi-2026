# The plaintext source of truth NEVER goes to the public repo — publishing it
# would make the credential gate decorative. Lives locally only.
manifest.json
*.bak
.env
.env.*
*.pem
*.key
id_rsa*
__pycache__/

# competition data — large, and redistribution is forbidden by the rules
work/data/
work/splits/

.channel_key
worker/wiring.json

# Kaggle dataset payload (RDKit wheels, trimmed COCONUT) -- rebuilt locally, uploaded to Kaggle, not versioned here
work/notebook/dataset/wheels/
work/notebook/dataset/coconut_min.parquet
work/notebook/submission.csv

# regenerable prediction artifacts -- large, reproducible from the work lists + checkpoints
exports/*.npz
work/results/*.log

# --- 2026-09-27, the bond-depth and reranker work ---
